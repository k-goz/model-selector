{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://model.ai-selector.top/schemas/models-data.v2.schema.json",
  "title": "AI Model Selector production catalog v2",
  "type": "object",
  "required": ["meta", "platforms", "models"],
  "properties": {
    "meta": {
      "type": "object",
      "required": ["schema_version", "identity_version", "updated_at", "total_models", "price_status_counts", "lineage_counts", "context_status_counts", "source_runs"],
      "properties": {
        "schema_version": {"const": "2.0.0"},
        "identity_version": {"const": "1"},
        "updated_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2} [0-9]{2}:[0-9]{2}$"},
        "total_models": {"type": "integer", "minimum": 1},
        "price_status_counts": {"type": "object"},
        "lineage_counts": {"type": "object"},
        "context_status_counts": {"type": "object"},
        "source_runs": {"type": "object"}
      },
      "additionalProperties": true
    },
    "platforms": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["name", "color"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "color": {"type": "string", "minLength": 1}
        },
        "additionalProperties": true
      }
    },
    "models": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/model"}}
  },
  "additionalProperties": true,
  "$defs": {
    "nullableDateTime": {"type": ["string", "null"], "format": "date-time"},
    "confidenceFactor": {
      "type": "object",
      "required": ["factor", "impact"],
      "properties": {
        "factor": {"type": "string", "minLength": 1},
        "impact": {"type": "number", "minimum": -1, "maximum": 1}
      },
      "additionalProperties": false
    },
    "model": {
      "type": "object",
      "required": [
        "identity_version", "canonical_model_id", "provider_offering_id", "provider_id", "provider_model_name",
        "model_family", "version", "region", "aliases", "platform_id", "name", "input_price", "output_price",
        "cache_input_price", "currency", "price_unit", "price_status", "billing_unit", "price_src", "base_url",
        "price_source_url", "model_source", "source_url", "collected_at", "evidence_at", "price_effective_at",
        "context_status", "context_source", "confidence", "lifecycle", "data_warnings"
      ],
      "properties": {
        "identity_version": {"const": "1"},
        "canonical_model_id": {"type": "string", "pattern": "^model_[0-9a-f]{20}$"},
        "provider_offering_id": {"type": "string", "pattern": "^offering_[0-9a-f]{20}$"},
        "provider_id": {"type": "string", "minLength": 1},
        "provider_model_name": {"type": "string", "minLength": 1},
        "model_family": {"type": "string", "minLength": 1},
        "version": {"type": ["string", "null"]},
        "region": {"type": "string", "minLength": 1},
        "aliases": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "platform_id": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "input_price": {"type": "number", "minimum": 0},
        "output_price": {"type": "number", "minimum": 0},
        "cache_input_price": {"type": ["number", "null"], "minimum": 0},
        "currency": {"type": "string", "minLength": 1},
        "price_unit": {"type": "string", "minLength": 1},
        "price_status": {"enum": ["priced", "free", "free_tier", "non_token", "unknown", "unavailable", "retiring"]},
        "billing_unit": {"enum": ["token", "request", "unknown"]},
        "price_src": {"type": "string"},
        "base_url": {"type": "string"},
        "price_source_url": {"type": "string"},
        "model_source": {"enum": ["api", "scrape", "fallback", "legacy_generator", "legacy_snapshot"]},
        "source_url": {"type": "string"},
        "collected_at": {"type": "string", "format": "date-time"},
        "evidence_at": {"type": "string", "format": "date-time"},
        "price_effective_at": {"$ref": "#/$defs/nullableDateTime"},
        "context_status": {"enum": ["known", "inferred", "not_applicable", "unknown"]},
        "context_source": {"type": "string", "minLength": 1},
        "tags": {"type": "array", "items": {"type": "string"}},
        "confidence": {
          "type": "object",
          "required": ["score", "grade", "factors", "method"],
          "properties": {
            "score": {"type": "number", "minimum": 0, "maximum": 1},
            "grade": {"enum": ["high", "medium", "low"]},
            "factors": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/confidenceFactor"}},
            "method": {"const": "catalog-confidence-v1"}
          },
          "additionalProperties": false
        },
        "lifecycle": {
          "type": "object",
          "required": ["status", "since", "retirement_at"],
          "properties": {
            "status": {"enum": ["preview", "active", "deprecated", "retiring", "unavailable", "retired", "unknown"]},
            "since": {"$ref": "#/$defs/nullableDateTime"},
            "retirement_at": {"$ref": "#/$defs/nullableDateTime"}
          },
          "additionalProperties": false
        },
        "data_warnings": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      },
      "additionalProperties": true
    }
  }
}
