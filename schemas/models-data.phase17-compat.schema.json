{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-model-selector.local/schemas/models-data.phase17-compat.schema.json",
  "title": "Model Selector Phase 17 compatibility catalog",
  "type": "object",
  "required": ["meta", "platforms", "models"],
  "properties": {
    "meta": {
      "type": "object",
      "required": ["updated_at", "total_models", "price_status_counts", "lineage_counts", "context_status_counts", "source_runs"],
      "properties": {
        "updated_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2} [0-9]{2}:[0-9]{2}$"},
        "total_models": {"type": "integer", "minimum": 1},
        "price_status_counts": {"type": "object"},
        "lineage_counts": {"type": "object"},
        "context_status_counts": {"type": "object"},
        "source_runs": {"type": "object"}
      },
      "additionalProperties": true
    },
    "platforms": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["name", "color"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "color": {"type": "string", "minLength": 1}
        },
        "additionalProperties": true
      }
    },
    "models": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/model"}}
  },
  "additionalProperties": true,
  "$defs": {
    "model": {
      "type": "object",
      "required": ["platform_id", "name", "input_price", "output_price", "currency", "price_status", "billing_unit", "price_src", "base_url", "price_source_url", "model_source", "source_url", "collected_at", "context_status", "context_source"],
      "properties": {
        "platform_id": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "input_price": {"type": "number", "minimum": 0},
        "output_price": {"type": "number", "minimum": 0},
        "currency": {"type": "string", "minLength": 1},
        "price_status": {"enum": ["priced", "free", "free_tier", "non_token", "unknown", "unavailable", "retiring"]},
        "billing_unit": {"enum": ["token", "request", "unknown"]},
        "price_src": {"type": "string"},
        "base_url": {"type": "string"},
        "price_source_url": {"type": "string"},
        "model_source": {"enum": ["api", "scrape", "fallback", "legacy_generator", "legacy_snapshot"]},
        "source_url": {"type": "string"},
        "collected_at": {"type": "string", "format": "date-time"},
        "context_status": {"enum": ["known", "inferred", "not_applicable", "unknown"]},
        "context_source": {"type": "string", "minLength": 1},
        "tags": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    }
  }
}
