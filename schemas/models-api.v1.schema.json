{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://model.ai-selector.top/schemas/models-api.v1.schema.json",
  "title": "AI Model Selector API v1 response",
  "type": "object",
  "required": ["api_version", "schema_version", "data_updated_at", "license", "pagination", "items"],
  "properties": {
    "api_version": {"const": "1.0.0"},
    "schema_version": {"type": "string"},
    "data_updated_at": {"type": "string"},
    "license": {"type": "string", "minLength": 1},
    "pagination": {
      "type": "object",
      "required": ["limit", "returned", "total", "next_cursor"],
      "properties": {
        "limit": {"type": "integer", "minimum": 1, "maximum": 100},
        "returned": {"type": "integer", "minimum": 0},
        "total": {"type": "integer", "minimum": 0},
        "next_cursor": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "items": {"type": "array", "maxItems": 100, "items": {"type": "object"}}
  },
  "additionalProperties": false
}
